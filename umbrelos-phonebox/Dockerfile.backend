# Android Cloud backend image: builds the upstream Phonebox backend.
# Pin PHONEBOX_REF to a reviewed commit/tag before production publishing.
ARG NODE_VERSION=20-bookworm-slim
FROM node:${NODE_VERSION} AS deps
ARG PHONEBOX_REF=master
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 make g++ openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${PHONEBOX_REF}" https://github.com/pfurpass/phonebox.git /src/phonebox
WORKDIR /src/phonebox/backend
RUN npm ci --include=dev

FROM deps AS build
WORKDIR /src/phonebox/backend
RUN npx prisma generate
RUN npm run build

FROM node:${NODE_VERSION} AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates dumb-init \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app \
    && useradd -r -g app -u 10001 app
COPY --from=build /src/phonebox/backend/node_modules ./node_modules
COPY --from=build /src/phonebox/backend/dist ./dist
COPY --from=build /src/phonebox/backend/prisma ./prisma
COPY --from=build /src/phonebox/backend/assets ./assets
COPY --from=build /src/phonebox/backend/src ./src
COPY --from=build /src/phonebox/backend/scripts ./scripts
COPY --from=build /src/phonebox/backend/package.json ./
RUN npm prune --omit=dev && npx prisma generate && chown -R app:app /app
USER app
ENV PORT=4000
EXPOSE 4000
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]
