# Builds the Phonebox SPA and installs an Umbrel-compatible reverse proxy config.
FROM node:20-alpine AS build
ARG PHONEBOX_REF=master
RUN apk add --no-cache git
RUN git clone --depth 1 --branch "${PHONEBOX_REF}" https://github.com/pfurpass/phonebox.git /src/phonebox
WORKDIR /src/phonebox/frontend
RUN npm ci
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/phonebox/frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
